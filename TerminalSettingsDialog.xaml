<Window x:Class="BIOSForwardManager.TerminalSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="終端機設定" Height="540" Width="580"
        WindowStartupLocation="CenterOwner"
        Background="#252526" Foreground="#DCDCDC"
        ShowInTaskbar="False" FontSize="13">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Background="#2D2D30" BorderBrush="#3E3E42" Foreground="#DCDCDC">

            <!-- ===== 字型 ===== -->
            <TabItem Header="  字型  ">
                <StackPanel Margin="16">
                    <TextBlock Text="字型" Margin="0,0,0,4"/>
                    <ComboBox x:Name="FontCombo" Height="28" Margin="0,0,0,4"
                              VerticalContentAlignment="Center"/>
                    <TextBlock Text="僅列出等寬字型 — 比例字型（如微軟正黑體）會導致字元錯位與奇怪空白"
                               Foreground="#999" FontSize="11" Margin="0,0,0,14" TextWrapping="Wrap"/>

                    <TextBlock Text="大小" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="SizeSlider" Minimum="8" Maximum="40" Value="14"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center"/>
                        <TextBlock x:Name="SizeLabel" Grid.Column="1" Text="14"
                                   Margin="10,0,0,0" VerticalAlignment="Center"
                                   Width="34" TextAlignment="Right" FontSize="14"/>
                    </Grid>

                    <CheckBox x:Name="BoldCheck" Content="粗體" Margin="0,0,0,14"
                              Foreground="#DCDCDC"/>

                    <TextBlock Text="預覽" Margin="0,0,0,4"/>
                    <Border x:Name="PreviewBorder" Background="#1E1E1E"
                            CornerRadius="4" Padding="12" MinHeight="90">
                        <StackPanel x:Name="PreviewPanel">
                            <TextBlock x:Name="Pv1">
                                <Run x:Name="PvUser" Text="u10702003@bu9biosjs001"/><Run x:Name="PvPath" Text=":~$ "/><Run x:Name="PvCmd" Text="ls -la"/>
                            </TextBlock>
                            <TextBlock x:Name="Pv2" Text="total 42"/>
                            <TextBlock x:Name="Pv3" Text="-rw-r--r--  1 user group  1234 Sep 11 10:30 file.txt"/>
                            <TextBlock x:Name="Pv4" Text="The quick brown fox 0123456789"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- ===== 顏色 ===== -->
            <TabItem Header="  顏色  ">
                <StackPanel Margin="16">
                    <TextBlock Text="點選色塊按鈕可開啟系統取色器。" Foreground="#999"
                               Margin="0,0,0,14" TextWrapping="Wrap"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 背景 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="背景色"
                                   VerticalAlignment="Center" Margin="0,0,14,10"/>
                        <Button x:Name="BgBtn" Grid.Row="0" Grid.Column="1"
                                Width="70" Height="26" Margin="0,0,14,10"
                                Click="OnPickBg" BorderBrush="#555"/>
                        <TextBlock x:Name="BgHex" Grid.Row="0" Grid.Column="2"
                                   Text="#1E1E1E" VerticalAlignment="Center"
                                   Margin="0,0,0,10" FontFamily="Consolas"/>

                        <!-- 前景 -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="前景色"
                                   VerticalAlignment="Center" Margin="0,0,14,10"/>
                        <Button x:Name="FgBtn" Grid.Row="1" Grid.Column="1"
                                Width="70" Height="26" Margin="0,0,14,10"
                                Click="OnPickFg" BorderBrush="#555"/>
                        <TextBlock x:Name="FgHex" Grid.Row="1" Grid.Column="2"
                                   Text="#DCDCDC" VerticalAlignment="Center"
                                   Margin="0,0,0,10" FontFamily="Consolas"/>

                        <!-- 游標 -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="游標色"
                                   VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <Button x:Name="CurBtn" Grid.Row="2" Grid.Column="1"
                                Width="70" Height="26" Margin="0,0,14,0"
                                Click="OnPickCur" BorderBrush="#555"/>
                        <TextBlock x:Name="CurHex" Grid.Row="2" Grid.Column="2"
                                   Text="#DCDCDC" VerticalAlignment="Center"
                                   FontFamily="Consolas"/>
                    </Grid>

                    <TextBlock Text="提示：前景色是「預設文字色」，遠端明確指定的顏色（如 prompt 的綠/藍）不受影響。"
                               Foreground="#999" Margin="0,16,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </TabItem>

            <!-- ===== 終端機 ===== -->
            <TabItem Header="  終端機  ">
                <StackPanel Margin="16">
                    <TextBlock Text="Scrollback 列數（可往上捲動的历史列數）" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="ScrollSlider" Minimum="100" Maximum="20000"
                                Value="5000" TickFrequency="100" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center"/>
                        <TextBlock x:Name="ScrollLabel" Grid.Column="1" Text="5000"
                                   Margin="10,0,0,0" VerticalAlignment="Center"
                                   Width="54" TextAlignment="Right" FontSize="14"/>
                    </Grid>

                    <CheckBox x:Name="BlinkCheck" Content="游標閃爍" Foreground="#DCDCDC"/>

                    <TextBlock Margin="0,20,0,0" Foreground="#999" TextWrapping="Wrap"
                               Text="其他操作：Ctrl+V 或右鍵 = 貼上；選取文字後 Ctrl+C = 複製；Ctrl+Z = 中止目前程式（SIGTSTP）。"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- ===== 按鈕列 ===== -->
        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="OkBtn" Content="確定" Width="88" Height="30"
                    Margin="0,0,10,0" Click="OnOk" IsDefault="True"
                    Background="#0E639C" Foreground="White" BorderBrush="#1177BB"/>
            <Button x:Name="CancelBtn" Content="取消" Width="88" Height="30"
                    Click="OnCancel" IsCancel="True"
                    Background="#3E3E42" Foreground="#DCDCDC" BorderBrush="#555"/>
        </StackPanel>
    </Grid>
</Window>
