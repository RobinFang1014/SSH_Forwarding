<Window x:Class="BIOSForwardManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BIOSForwardManager.ViewModels"
        xmlns:models="clr-namespace:BIOSForwardManager.Models"
        xmlns:conv="clr-namespace:BIOSForwardManager.Converters"
        Title="BIOS Lab Manager (WPF TreeListView)"
        Height="640" Width="940"
        MinHeight="400" MinWidth="680"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft JhengHei, Segoe UI"
        FontSize="13"
        Background="#F3F3F3">

    <Window.Resources>
        <!-- 欄寬（表頭與列項目共用同一實例，拖曳時同步） -->
        <vm:ColumnWidths x:Key="ColWidths"/>
        <conv:LevelToMarginConverter x:Key="LevelToMargin"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 展開/折疊切換按鈕（三角形，展開時旋轉） -->
        <Style x:Key="ExpanderToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Width="16" Height="16">
                            <Path x:Name="arrow"
                                  Data="M 0,0 L 5,4 L 0,8 Z"
                                  Fill="#5A5A5A"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="arrow" Property="Data" Value="M 0,0 L 8,0 L 4,5 Z"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="arrow" Property="Fill" Value="#0078D7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 列容器：移除預設內距，加入懸停/選取樣式 -->
        <Style x:Key="ItemContainerStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="#D5D5D5" BorderThickness="0,0,0,1"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#CCE8FF"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="bd" Property="Background" Value="#EAF4FD"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 表頭儲存格 -->
        <Style x:Key="HeaderCellStyle" TargetType="Border">
            <Setter Property="Background" Value="#F5F6F7"/>
            <Setter Property="BorderBrush" Value="#D5D5D5"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- 欄位拖曳分割線 -->
        <Style x:Key="ColumnSplitterStyle" TargetType="Border">
            <Setter Property="Width" Value="6"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="SizeWE"/>
        </Style>

        <!-- 格線儲存格（右邊框 → 垂直格線） -->
        <Style x:Key="GridLineCell" TargetType="Border">
            <Setter Property="BorderBrush" Value="#D5D5D5"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ===== 工具列 ===== -->
        <ToolBarTray DockPanel.Dock="Top" Background="#F0F0F0" IsLocked="True">
            <ToolBar Band="0" BandIndex="0" Padding="6,3">
                <Button Command="{Binding ConnectMasterCommand}" ToolTip="連線 / 離開 SSH Master" Padding="8,4" Margin="2,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ConnectButtonText}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding StartAutoCommand}" ToolTip="啟動所有 AUTO 連線" Padding="8,4" Margin="2,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🚀" FontFamily="Segoe UI Emoji" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="Start Auto" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Separator Margin="4,2"/>
                <Button Command="{Binding AddConnectionCommand}" ToolTip="新增連線" Padding="8,4" Margin="2,0">
                    <TextBlock Text="Add" VerticalAlignment="Center"/>
                </Button>
                <Button Command="{Binding EditConnectionCommand}" ToolTip="編輯選取連線" Padding="8,4" Margin="2,0">
                    <TextBlock Text="Edit" VerticalAlignment="Center"/>
                </Button>
                <Button Command="{Binding RemoveConnectionCommand}" ToolTip="移除選取連線" Padding="8,4" Margin="2,0">
                    <TextBlock Text="Remove" VerticalAlignment="Center"/>
                </Button>
                <Button Command="{Binding ClearAllCommand}" ToolTip="清除所有 ACTIVE 轉發" Padding="8,4" Margin="2,0">
                    <TextBlock Text="Clear All" VerticalAlignment="Center"/>
                </Button>
                <Separator Margin="4,2"/>
                <Button Command="{Binding ExpandAllCommand}" ToolTip="展開所有分組" Padding="8,4" Margin="2,0">
                    <TextBlock Text="Expand All" VerticalAlignment="Center"/>
                </Button>
                <Button Command="{Binding CollapseAllCommand}" ToolTip="折疊所有分組" Padding="8,4" Margin="2,0">
                    <TextBlock Text="Collapse All" VerticalAlignment="Center"/>
                </Button>
                <Separator Margin="4,2"/>
                <Button Command="{Binding OpenConsoleCommand}" ToolTip="開啟 SSH Terminal（在 Jump Server 下指令）" Padding="8,4" Margin="2,0">
                    <TextBlock Text="🖥 Terminal" VerticalAlignment="Center"/>
                </Button>
                <Button Command="{Binding SshSettingsCommand}" ToolTip="編輯 SSH 主連線設定" Padding="8,4" Margin="2,0">
                    <TextBlock Text="⚙ SSH 設定" VerticalAlignment="Center"/>
                </Button>
                <Button Command="{Binding ExitCommand}" ToolTip="結束程式" Padding="8,4" Margin="2,0">
                    <TextBlock Text="✕ Exit" VerticalAlignment="Center" Foreground="#CC0000"/>
                </Button>
            </ToolBar>
        </ToolBarTray>

        <!-- ===== 狀態列 ===== -->
        <StatusBar DockPanel.Dock="Bottom" Background="#F0F0F0" Padding="6,2">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Fill="{Binding StatusBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"/>
                </StackPanel>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding UptimeText}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding ResultText}" Foreground="{Binding ResultBrush}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding TotalCount, StringFormat='共 {0} 條'}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding ActiveCount, StringFormat='ACTIVE {0}'}" Foreground="#0078D7"/>
            </StatusBarItem>
        </StatusBar>

        <!-- ===== 主內容：表頭 + 列表 ===== -->
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 表頭（與列項目使用相同的欄寬綁定） -->
            <Border Grid.Row="0" Background="#F5F6F7" BorderBrush="#C8C8C8" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding NameWidth, Source={StaticResource ColWidths}}"/>
                        <ColumnDefinition Width="{Binding TypeWidth, Source={StaticResource ColWidths}}"/>
                        <ColumnDefinition Width="{Binding LPortWidth, Source={StaticResource ColWidths}}"/>
                        <ColumnDefinition Width="{Binding RPortWidth, Source={StaticResource ColWidths}}"/>
                        <ColumnDefinition Width="{Binding StatusWidth, Source={StaticResource ColWidths}}"/>
                        <ColumnDefinition Width="{Binding ActionWidth, Source={StaticResource ColWidths}}"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource HeaderCellStyle}">
                        <Grid>
                            <TextBlock Text="名稱 (Remote IP)" FontWeight="SemiBold" Foreground="#333" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <Border Style="{StaticResource ColumnSplitterStyle}" Tag="0"
                                    MouseLeftButtonDown="OnSplitterMouseDown"
                                    MouseMove="OnSplitterMouseMove"
                                    MouseUp="OnSplitterMouseUp"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource HeaderCellStyle}">
                        <Grid>
                            <TextBlock Text="Type" FontWeight="SemiBold" Foreground="#333" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <Border Style="{StaticResource ColumnSplitterStyle}" Tag="1"
                                    MouseLeftButtonDown="OnSplitterMouseDown"
                                    MouseMove="OnSplitterMouseMove"
                                    MouseUp="OnSplitterMouseUp"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource HeaderCellStyle}">
                        <Grid>
                            <TextBlock Text="L-Port" FontWeight="SemiBold" Foreground="#333" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <Border Style="{StaticResource ColumnSplitterStyle}" Tag="2"
                                    MouseLeftButtonDown="OnSplitterMouseDown"
                                    MouseMove="OnSplitterMouseMove"
                                    MouseUp="OnSplitterMouseUp"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="3" Style="{StaticResource HeaderCellStyle}">
                        <Grid>
                            <TextBlock Text="R-Port" FontWeight="SemiBold" Foreground="#333" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <Border Style="{StaticResource ColumnSplitterStyle}" Tag="3"
                                    MouseLeftButtonDown="OnSplitterMouseDown"
                                    MouseMove="OnSplitterMouseMove"
                                    MouseUp="OnSplitterMouseUp"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource HeaderCellStyle}">
                        <Grid>
                            <TextBlock Text="Status" FontWeight="SemiBold" Foreground="#333" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <Border Style="{StaticResource ColumnSplitterStyle}" Tag="4"
                                    MouseLeftButtonDown="OnSplitterMouseDown"
                                    MouseMove="OnSplitterMouseMove"
                                    MouseUp="OnSplitterMouseUp"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="5" Style="{StaticResource HeaderCellStyle}" BorderThickness="0">
                        <TextBlock Text="Action" FontWeight="SemiBold" Foreground="#333" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 列表（扁平化的樹狀項目） -->
            <ListView Grid.Row="1"
                      x:Name="ForwardListView"
                      ItemsSource="{Binding VisibleItems}"
                      SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                      ItemContainerStyle="{StaticResource ItemContainerStyle}"
                      AllowDrop="True"
                      PreviewMouseLeftButtonDown="OnListViewMouseLeftButtonDown"
                      MouseWheel="OnListViewMouseWheel"
                      DragOver="OnDragOver"
                      Drop="OnDrop"
                      DragLeave="OnDragLeave"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      BorderThickness="0"
                      Background="White"
                      Padding="0">
                <ListView.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:ForwardItem}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding NameWidth, Source={StaticResource ColWidths}}"/>
                                <ColumnDefinition Width="{Binding TypeWidth, Source={StaticResource ColWidths}}"/>
                                <ColumnDefinition Width="{Binding LPortWidth, Source={StaticResource ColWidths}}"/>
                                <ColumnDefinition Width="{Binding RPortWidth, Source={StaticResource ColWidths}}"/>
                                <ColumnDefinition Width="{Binding StatusWidth, Source={StaticResource ColWidths}}"/>
                                <ColumnDefinition Width="{Binding ActionWidth, Source={StaticResource ColWidths}}"/>
                            </Grid.ColumnDefinitions>

                            <!-- 名稱欄：依層級縮排（展開鈕 + 圖示 + 名稱） -->
                            <Border Grid.Column="0" Style="{StaticResource GridLineCell}">
                                <Grid Margin="{Binding Level, Converter={StaticResource LevelToMargin}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center">
                                        <ToggleButton Style="{StaticResource ExpanderToggleStyle}"
                                                      IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                      Visibility="{Binding HasChildren, Converter={StaticResource BoolToVis}}"
                                                      Click="OnToggleClick"/>
                                    </Border>

                                    <Image Grid.Column="1"
                                           Source="{Binding Icon}"
                                           Width="16" Height="16"
                                           Margin="2,0,6,0"
                                           VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>

                                    <TextBlock x:Name="NameTextBlock" Grid.Column="2"
                                               Text="{Binding DisplayName}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource GridLineCell}">
                                <TextBlock Text="{Binding TypeText}"
                                           Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#444"/>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource GridLineCell}">
                                <TextBlock Text="{Binding LocalPortText}"
                                           Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#444"/>
                            </Border>
                            <Border Grid.Column="3" Style="{StaticResource GridLineCell}">
                                <TextBlock Text="{Binding RemotePortText}"
                                           Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#444"/>
                            </Border>

                            <!-- Status 欄（ACTIVE 時綠底） -->
                            <Border Grid.Column="4" Style="{StaticResource GridLineCell}">
                                <Border Margin="8,0,0,0" VerticalAlignment="Center"
                                        HorizontalAlignment="Left" Padding="8,2" CornerRadius="3" Background="White">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsConnection}" Value="True"/>
                                                        <Condition Binding="{Binding IsActive}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Background" Value="#D5F5D5"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding DisplayStatus}" VerticalAlignment="Center" Foreground="#444">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsConnection}" Value="True"/>
                                                            <Condition Binding="{Binding IsActive}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Foreground" Value="DarkGreen"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Border>

                            <!-- Action 按鈕（僅連線顯示，最後一欄不加右格線） -->
                            <Button Grid.Column="5" Margin="8,0,4,0" Padding="10,2"
                                    Content="{Binding ActionText}"
                                    Visibility="{Binding IsConnection, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding DataContext.ToggleForwardCommand, Source={x:Reference ForwardListView}}"
                                    CommandParameter="{Binding}"/>
                        </Grid>

                        <DataTemplate.Triggers>
                            <!-- Group 節點：名稱加粗 -->
                            <DataTrigger Binding="{Binding ItemType}" Value="Group">
                                <Setter TargetName="NameTextBlock" Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- 拖曳放置指示線（覆蓋在列表上方） -->
            <Rectangle x:Name="DropIndicatorLine"
                       Grid.Row="1"
                       Height="2"
                       Fill="#0078D7"
                       VerticalAlignment="Top"
                       HorizontalAlignment="Stretch"
                       IsHitTestVisible="False"
                       Visibility="Collapsed"/>
        </Grid>
    </DockPanel>
</Window>
