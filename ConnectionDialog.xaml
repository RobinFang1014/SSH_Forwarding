<Window x:Class="BIOSForwardManager.ConnectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Connection" Height="400" Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Microsoft JhengHei, Segoe UI" FontSize="13"
        Background="#F3F3F3">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Type (http/SSH)" VerticalAlignment="Center"/>
        <TextBox x:Name="TypeBox" Grid.Row="0" Grid.Column="1" Margin="0,4" Padding="4,3"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Display Name" VerticalAlignment="Center"/>
        <TextBox x:Name="NameBox" Grid.Row="1" Grid.Column="1" Margin="0,4" Padding="4,3"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Local Port" VerticalAlignment="Center"/>
        <TextBox x:Name="LocalPortBox" Grid.Row="2" Grid.Column="1" Margin="0,4" Padding="4,3"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Remote IP" VerticalAlignment="Center"/>
        <TextBox x:Name="RemoteIpBox" Grid.Row="3" Grid.Column="1" Margin="0,4" Padding="4,3"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Remote Port" VerticalAlignment="Center"/>
        <TextBox x:Name="RemotePortBox" Grid.Row="4" Grid.Column="1" Margin="0,4" Padding="4,3"/>

        <CheckBox x:Name="AutoCheck" Grid.Row="5" Grid.Column="1"
                  Content="Auto Start on Master Connect" Margin="0,10,0,0" VerticalAlignment="Center"/>

        <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="SaveButton" Content="SAVE" Width="90" Height="32"
                    Margin="0,0,8,0" IsDefault="True" Click="OnSaveClick"/>
            <Button Content="Cancel" Width="90" Height="32" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
