<Window x:Class="BIOSForwardManager.TerminalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:BIOSForwardManager.Controls"
        Title="SSH Terminal" Height="550" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        Closing="OnWindowClosing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 工具列：字型/顏色設定 + 操作提示 -->
        <Border Grid.Row="0" Background="#2D2D30" Padding="8,5">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="ClearBtn" Content="🗑 清除畫面"
                        Click="OnClearClick" Padding="10,4" Margin="0,0,12,0"
                        Background="#3E3E42" Foreground="#DCDCDC" BorderBrush="#555"/>
                <Button x:Name="SettingsBtn" Content="⚙ 字型 / 顏色設定"
                        Click="OnSettingsClick" Padding="10,4" Margin="0,0,12,0"
                        Background="#3E3E42" Foreground="#DCDCDC" BorderBrush="#555"/>
                <TextBlock Text="Ctrl+V / 右鍵 = 貼上    選取後 Ctrl+C = 複製    Ctrl+Z = 中止程式"
                           VerticalAlignment="Center" Foreground="#888" FontSize="11"/>
            </StackPanel>
        </Border>

        <!-- 自訂 grid-based 終端機模擬器：支援 ANSI/VT100、顏色、游標定位、滑鼠選取 + scroll bar -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <controls:TerminalControl x:Name="Term" Grid.Column="0" Margin="4"/>
            <ScrollBar x:Name="Scroll" Grid.Column="1" Orientation="Vertical"
                       Minimum="0" SmallChange="1" LargeChange="10"
                       Scroll="OnScrollChanged"/>
        </Grid>
    </Grid>
</Window>
