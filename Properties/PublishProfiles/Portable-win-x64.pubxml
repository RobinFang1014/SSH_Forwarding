<?xml version="1.0" encoding="utf-8"?>
<!--
  免安裝 .NET 的可攜版：把 .NET Runtime 一起打包成單一 EXE。
  目標電腦不需安裝 .NET、不需 Admin 權限，複製 exe 即可執行。

  VS：專案右鍵 → 發佈 → 選 Portable-win-x64 → 發佈
  CLI：dotnet publish -p:PublishProfile=Portable-win-x64
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishDir>bin\Publish\Portable-win-x64\</PublishDir>

    <!-- 內含 .NET Runtime（免安裝） -->
    <SelfContained>true</SelfContained>

    <!-- 打包成單一 EXE；WPF 的原生 DLL 也包進去（首次執行時解壓到 %TEMP%\.net） -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- WPF 不支援 Trimming -->
    <PublishTrimmed>false</PublishTrimmed>

    <!-- Release 不需要 pdb -->
    <DebugType>none</DebugType>
  </PropertyGroup>
</Project>
