<Window x:Class="BIOSForwardManager.LoginDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SSH Login" Height="220" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Password:" VerticalAlignment="Center" FontWeight="Bold"/>
        <PasswordBox x:Name="PasswordBox" Grid.Row="0" Grid.Column="1" Margin="0,4" Padding="4"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="2FA Code:" VerticalAlignment="Center" FontWeight="Bold"/>
        <TextBox x:Name="TotpBox" Grid.Row="1" Grid.Column="1" Margin="0,4" Padding="4"
                 ToolTip="6-digit TOTP code from your authenticator app"/>

        <TextBlock x:Name="ErrorText" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                   Foreground="Red" FontSize="11" Margin="0,4" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Connect" Width="90" Height="30" Margin="0,0,8,0" Click="OnConnect" IsDefault="True"/>
            <Button Content="Cancel" Width="90" Height="30" Click="OnCancel" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
